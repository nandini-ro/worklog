DATABASE_URL=postgresql+psycopg://worklog:worklog@localhost:5432/worklog
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI is optional. AI_PROVIDER: auto | openai | groq | gemini | local
# "auto" uses the first configured key (openai → groq → gemini), else the offline local fallback.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
