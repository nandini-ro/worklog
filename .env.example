# Used by docker-compose. Copy to .env and adjust.
JWT_SECRET=replace-with-a-long-random-string
SEED_DEMO=false
# Leave empty for no password on your own machine; set it to lock the app.
APP_PASSWORD=

# Optional AI provider keys (the app works without them)
AI_PROVIDER=auto
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
